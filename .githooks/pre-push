#!/usr/bin/env bash
# Enabled with: make setup (git config core.hooksPath .githooks)
# Refuses a push to main or master (docs/agents/git.md), then runs `make lint` and `make test` when the Makefile
# has those targets, so a lint or test error cannot reach an open pull request.
# Git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per ref on stdin.
set -euo pipefail

zero=0000000000000000000000000000000000000000
push=0
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      cat >&2 <<EOF2
pre-push: refusing to push to '${remote_ref#refs/heads/}'. main only changes through a pull request.
Push a branch and open a pull request:
  git push -u origin <type>/<issue>-<slug>
Branch names and the flow: docs/agents/git.md. Do not use --no-verify.
EOF2
      exit 1
      ;;
  esac
  [[ "$local_sha" == "$zero" ]] || push=1 # a delete pushes no commits
done
[[ $push -eq 1 ]] || exit 0

cd "$(git rev-parse --show-toplevel)"
for target in lint test; do
  if [[ -f Makefile ]] && grep -q "^${target}:" Makefile; then
    make "$target" || { echo "pre-push: make $target failed, nothing was pushed. Fix it, do not use --no-verify." >&2; exit 1; }
  fi
done
