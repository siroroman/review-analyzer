# Every variable app/main.py reads. Placeholders only: copy to .env (never committed) and fill in.
# A missing or empty required one stops the start and names the variable.

# Access: comma separated Demo tokens (required), the admin token (optional)
DEMO_TOKENS=demo-token-1,demo-token-2
ADMIN_TOKEN=

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/review_analyzer

# Paid services
GOOGLE_PLACES_API_KEY=your-google-places-key
YASOGAN_URL=http://localhost:8081
OPENROUTER_API_KEY=your-openrouter-api-key

# Langfuse (LANGFUSE_HOST is optional, default https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Cloud Tasks: the queue and the worker it pushes to
CLOUD_TASKS_PROJECT=your-gcp-project
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=runs
WORKER_URL=https://your-worker.example/tasks/run
WORKER_SERVICE_ACCOUNT=worker@your-gcp-project.iam.gserviceaccount.com
