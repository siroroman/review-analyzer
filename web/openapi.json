{
  "openapi": "3.1.0",
  "info": {
    "title": "Review Analyzer API",
    "version": "0.1.0"
  },
  "paths": {
    "/places/suggest": {
      "get": {
        "summary": "Suggest",
        "operationId": "suggest_places_suggest_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[\\w\\s.,'&/()\\-]+$",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SuggestionOut"
                  },
                  "title": "Response Suggest Places Suggest Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/places/{place_id}/branches": {
      "get": {
        "summary": "Branches",
        "operationId": "branches_places__place_id__branches_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "place_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[A-Za-z0-9_\\-]+$",
              "title": "Place Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BranchOut"
                  },
                  "title": "Response Branches Places  Place Id  Branches Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "post": {
        "summary": "Create Run",
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/runs/{run_id}": {
      "get": {
        "summary": "Run Status",
        "operationId": "run_status_runs__run_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/result": {
      "get": {
        "summary": "Run Result",
        "operationId": "run_result_runs__run_id__result_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/reviews": {
      "get": {
        "summary": "Reviews of a Run by `ids` (Insight.review_ids) or by `topic` (a Topic key)",
        "description": "Exactly one of `ids` and `topic`. Only Reviews of the Run's Company are returned; unknown IDs are skipped and Flagged Reviews never appear. By `topic`: newest first, at most 200.",
        "operationId": "run_reviews_runs__run_id__reviews_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "maxItems": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ids"
            }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Topic"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewOut"
                  },
                  "title": "Response Run Reviews Runs  Run Id  Reviews Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/spend": {
      "get": {
        "summary": "Spend per service, day and Run, and the share of the monthly cap used",
        "description": "Admin token only (`Authorization: Bearer <admin token>`); a Demo token gives 401.",
        "operationId": "admin_spend_admin_spend_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpendOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong Admin token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/calls": {
      "get": {
        "summary": "The Call log, oldest first, with filters and pagination",
        "description": "Admin token only (`Authorization: Bearer <admin token>`); a Demo token gives 401. No request or response bodies are stored or shown. `since <= at < until`.",
        "operationId": "admin_calls_admin_calls_get",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Service"
            }
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Operation"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ok",
                    "denied",
                    "failed"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallsOut"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong Admin token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BranchOut": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          }
        },
        "type": "object",
        "required": [
          "place_id",
          "name",
          "address"
        ],
        "title": "BranchOut"
      },
      "CallOut": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "denied",
              "failed"
            ],
            "title": "Status"
          },
          "cost": {
            "type": "string",
            "title": "Cost"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "units": {
            "type": "integer",
            "title": "Units"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "error_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Kind"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "service",
          "operation",
          "run_id",
          "status",
          "cost",
          "unit",
          "units",
          "latency_ms",
          "error_kind",
          "at"
        ],
        "title": "CallOut"
      },
      "CallsOut": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CallOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "title": "CallsOut"
      },
      "Change": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChangeKind"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "title": "Period Start"
          },
          "delta": {
            "type": "number",
            "title": "Delta"
          },
          "main_topic_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Main Topic Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "source",
          "period_start",
          "delta"
        ],
        "title": "Change",
        "description": "A detected drop or rise of the average rating of one Source in one period."
      },
      "ChangeKind": {
        "type": "string",
        "enum": [
          "drop",
          "rise"
        ],
        "title": "ChangeKind"
      },
      "Company": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "places": {
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "type": "array",
            "minItems": 1,
            "title": "Places"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "places"
        ],
        "title": "Company",
        "description": "A set of Places the user confirmed as belonging together; the same set is the same Company.\n\nThe industry is unknown until the pipeline infers it from the downloaded Reviews."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Insight": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/InsightType"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "title": "Period Start"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "title": "Period End"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Text"
          },
          "review_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Review Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "period_start",
          "period_end",
          "text",
          "review_ids"
        ],
        "title": "Insight",
        "description": "A statement by the strong model that cites the IDs of the Reviews it rests on."
      },
      "InsightType": {
        "type": "string",
        "enum": [
          "summary",
          "anomaly",
          "suggestion"
        ],
        "title": "InsightType"
      },
      "Metrics": {
        "properties": {
          "trend": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
            },
            "type": "array",
            "title": "Trend"
          },
          "topic_shares": {
            "items": {
              "$ref": "#/components/schemas/TopicShare"
            },
            "type": "array",
            "title": "Topic Shares"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "type": "array",
            "title": "Changes"
          },
          "overall": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RatingSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "per_source": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "type": "array",
            "title": "Per Source",
            "default": []
          },
          "per_place": {
            "items": {
              "$ref": "#/components/schemas/PlaceSummary"
            },
            "type": "array",
            "title": "Per Place",
            "default": []
          },
          "rating_counts": {
            "items": {
              "$ref": "#/components/schemas/StarCount"
            },
            "type": "array",
            "title": "Rating Counts",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trend",
          "topic_shares",
          "changes"
        ],
        "title": "Metrics",
        "description": "Everything computed by code from Reviews and ReviewTopics."
      },
      "Place": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "title": "External Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "external_id",
          "name",
          "address"
        ],
        "title": "Place",
        "description": "One branch of a Company on one Source, identified by that Source's external ID."
      },
      "PlaceSummary": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "place_external_id": {
            "type": "string",
            "minLength": 1,
            "title": "Place External Id"
          },
          "summary": {
            "$ref": "#/components/schemas/RatingSummary"
          },
          "main_topic_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Main Topic Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "place_external_id",
          "summary"
        ],
        "title": "PlaceSummary",
        "description": "The RatingSummary of one Place, for the comparison of Places.\n\n`main_topic_key` is the Topic with the most negative mentions in the Place; None when it has none."
      },
      "RatingSummary": {
        "properties": {
          "average_rating": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Average Rating"
          },
          "count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "average_rating",
          "count"
        ],
        "title": "RatingSummary",
        "description": "The average rating and the number of Reviews of one group (all, one Source or one Place)."
      },
      "ResultOut": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "insights": {
            "items": {
              "$ref": "#/components/schemas/Insight"
            },
            "type": "array",
            "title": "Insights"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicOut"
            },
            "type": "array",
            "title": "Topics"
          },
          "reviews": {
            "type": "integer",
            "title": "Reviews"
          },
          "flagged": {
            "type": "integer",
            "title": "Flagged"
          },
          "unclassified": {
            "type": "integer",
            "title": "Unclassified"
          },
          "cost": {
            "type": "string",
            "title": "Cost"
          },
          "cost_by_service": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Cost By Service"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status",
          "company",
          "metrics",
          "insights",
          "topics",
          "reviews",
          "flagged",
          "unclassified",
          "cost",
          "cost_by_service",
          "notes"
        ],
        "title": "ResultOut"
      },
      "ReviewOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "place_name": {
            "type": "string",
            "title": "Place Name"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "text": {
